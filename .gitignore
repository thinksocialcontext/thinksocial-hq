# secrets (credentials belong in 1Password, not even here)
.env
.env.*
!.env.example

# private working state
memory/
work/
reports/*.md
!reports/README.md
approvals/*.md
!approvals/README.md
!approvals/example-onboard-example-boutique.md

# clients: only the template, the fake example and the example index are committed
clients/*
!clients/CLAUDE.md
!clients/README.md
!clients/INDEX.example.md
!clients/_template/
!clients/example-boutique/

# inventory: invoices, extracted lines, the master sheet, review files and sheets stay local
inventory/drop/*
!inventory/drop/README.md
inventory/extracted/*
!inventory/extracted/README.md
inventory/master/*
!inventory/master/README.md
inventory/review/*
!inventory/review/README.md
inventory/clients/*
!inventory/clients/_template/
!inventory/clients/example-boutique/
inventory/clients/example-boutique/sheets/
inventory/rules/*
