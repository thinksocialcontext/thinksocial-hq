# Copy to .env (./setup.sh does this). ThinkSocial keeps credentials in 1Password, one vault per client,
# so this file holds settings only. Never paste a password, token or key here, in a chat, a brief, a memory or the ledger.

# Dashboard port (it only ever listens on 127.0.0.1)
HQ_DASHBOARD_PORT=8765

# Force a backend for scripts/hq: herdr or tmux (blank means herdr if installed)
HQ_BACKEND=
